{
  "manifest_version": 3,
  "name": "Miteng tab audio",
  "description": "Send one tab's audio, such as a Google Meet or Teams call, to the Miteng recorder on this computer.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Send this tab's audio to Miteng",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Start or stop sending this tab's audio to Miteng"
    }
  }
}
